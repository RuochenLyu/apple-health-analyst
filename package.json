{
  "name": "apple-health-analyst",
  "version": "2.0.0",
  "description": "Privacy-conscious Apple Health export analyzer. Parses HealthKit data locally and produces bilingual health and multi-sport training reports with conservative, evidence-bounded narratives.",
  "type": "module",
  "bin": {
    "apple-health-analyst": "dist/cli.js"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.json && chmod +x dist/cli.js",
    "test": "vitest run",
    "dev": "tsx src/cli.ts",
    "check": "npm run build && npm test",
    "demo:prepare": "node scripts/generate-demo-insights.mjs",
    "demo:check": "npm run demo:prepare && git diff --exit-code -- examples/demo/en/summary.json examples/demo/en/insights.json examples/demo/zh/summary.json examples/demo/zh/insights.json",
    "docs:build": "npm run build && node scripts/build-demo.mjs",
    "docs:check": "npm run docs:build && git diff --exit-code -- docs",
    "pack:check": "node scripts/verify-package.mjs",
    "prepack": "npm run check && npm run pack:check"
  },
  "keywords": [
    "apple-health",
    "healthkit",
    "health-report",
    "quantified-self",
    "apple-watch",
    "cli",
    "codex-skill",
    "agent-skills",
    "claude-code-skill",
    "skill"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RuochenLyu/apple-health-analyst.git"
  },
  "homepage": "https://kshift.me/apple-health-analyst/",
  "bugs": {
    "url": "https://github.com/RuochenLyu/apple-health-analyst/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    ".agents/skills/apple-health-analyst",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "PRIVACY.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "dependencies": {
    "commander": "^14.0.3",
    "saxes": "^6.0.0",
    "unzipper": "^0.12.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/unzipper": "^0.10.11",
    "tsx": "^4.23.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
